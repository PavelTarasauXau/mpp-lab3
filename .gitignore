# Виртуальное окружение (добавьте свои названия папок, если они отличаются)
.venv/
venv/
env/
ENV/

# Кэш Python и байт-код (генерируются автоматически, захламляют коммит)
**/__pycache__/
*.py[cod]
*$py.class

# Файлы настроек вашей среды разработки (IDE)
.idea/             # Для PyCharm
.vscode/           # Для VS Code (можно оставить .vscode/settings.json, если настройки общие)
*.swp
*.swo

# Файлы окружения со скрытыми ключами и паролями (БЕЗОПАСНОСТЬ!)
.env
.env.local

# Логи и временные файлы
*.log
